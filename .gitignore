# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# unrelated project that lives alongside this one
/trading_strategy

# typescript
*.tsbuildinfo
next-env.d.ts

# Android build output
/android/.gradle
/android/build
/android/app/build
/android/local.properties
/android/.idea
/android/dist

# Logo source artwork. The icons are generated from it, but it's an 8 MB
# mockup and only needed when they're regenerated — keep it out of history.
/monogram.png

# Android signing — losing these means never being able to update the app,
# and committing them means anyone can sign as Academia. Back them up somewhere
# private instead (password manager), never here.
*.jks
*.keystore
/android/keystore.properties
